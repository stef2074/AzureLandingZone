connectivity_subscription_id = "<CONNECTIVITY_SUBSCRIPTION_ID>"
location                     = "eastus2"
resource_group_name          = "rg-connectivity"

virtual_network_name          = "vnet-hub"
virtual_network_address_space = "10.100.0.0/16"

gateway_subnet_name           = "GatewaySubnet"
gateway_subnet_address_prefix = "10.100.0.0/24"

shared_services_subnet_name           = "SharedServicesSubnet"
shared_services_subnet_address_prefix = "10.100.1.0/24"

network_security_group_name = "nsg-shared-services"
route_table_name            = "rt-shared-services"
